# Copy to .env and adjust for your environment.

# --- General ---
APP_NAME="Page Pulse"
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=true

# --- HTTP server ---
HOST=0.0.0.0
PORT=8000

# --- Outbound HTTP (httpx) ---
REQUEST_TIMEOUT_SECONDS=8.0
CONNECT_TIMEOUT_SECONDS=3.0
MAX_REDIRECTS=5
USER_AGENT="PagePulse-Audit-Bot/1.0 (+https://example.com/bot)"

# --- Concurrency ---
MAX_CONCURRENT_AUDITS=20

# --- Caching (Redis) ---
REDIS_URL=redis://localhost:6379/0
CACHE_ENABLED=true
CACHE_TTL_SECONDS=300
CACHE_KEY_PREFIX="pagepulse:audit:"

# --- Rate limiting (SlowAPI + Redis storage) ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT="60/minute"
RATE_LIMIT_AUDIT="10/minute"
RATE_LIMIT_STORAGE_URL=redis://localhost:6379/1

# --- Security ---
BLOCK_PRIVATE_NETWORKS=true
MAX_URL_LENGTH=2048
